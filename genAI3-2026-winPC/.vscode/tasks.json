{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build debug",
            "type": "shell",
            "command": "nmake debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$msCompile"],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "nmake clean",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}